NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bean
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

# For Neon, set DATABASE_URL to the pooled connection string from the Neon console.
# When DATABASE_URL is set, the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD values above are ignored.
DATABASE_URL=

# Generate a unique random secret with at least 32 characters.
SESSION_SECRET=
COOKIE_SAME_SITE=lax

# Comma-separated exact origins, with no trailing slash. Example:
APP_ORIGINS=http://localhost:5173

# Integration event worker settings
INTEGRATION_WORKER_INTERVAL_MS=300000
INTEGRATION_WORKER_BATCH_SIZE=100
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_LEASE_MS=300000
INTEGRATION_RETRY_DELAYS_MS=60000,300000,900000,3600000
INTEGRATION_RETENTION_INTERVAL_MS=86400000
INTEGRATION_RETENTION_BATCH_SIZE=500
INTEGRATION_EVENT_RETENTION_DAYS=90
INTEGRATION_ATTEMPT_RETENTION_DAYS=180
INTEGRATION_DIAGNOSTIC_RETENTION_DAYS=90
ANALYTICS_OUTBOX_RETENTION_DAYS=90

# ---- Identity and email ------------------------------------------------------------------------
# Public URL of the frontend. Links in emails (password reset, invitations) are built ONLY from this
# value and it must be one of the APP_ORIGINS above. Defaults to the first APP_ORIGINS entry.
APP_BASE_URL=http://localhost:5173

# Mail transport. smtp = real delivery (required when NODE_ENV=production).
# outbox = development only: each message is written to .mail-outbox/ so you can read the code.
# capture = automated tests (in memory). Verification codes are never written to the application log.
MAIL_TRANSPORT=outbox

# Only read when MAIL_TRANSPORT=smtp. Put real credentials in your deployment's secret store, never here.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465). false = STARTTLS is required; plaintext is never used.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Bean

# Optional (>= 32 characters). Secret used to hash one-time codes and tokens. Defaults to a key derived
# from SESSION_SECRET; set it separately if you want to rotate the two independently.
OTP_PEPPER=

# new-device (default): an unrecognised browser must enter an emailed code. off: disable step-up.
LOGIN_STEP_UP=new-device
