NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bean
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password

# For Neon, set DATABASE_URL to the pooled connection string from the Neon console.
# When DATABASE_URL is set, the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD values above are ignored.
DATABASE_URL=

# Generate a unique random secret with at least 32 characters.
SESSION_SECRET=
COOKIE_SAME_SITE=lax

# Comma-separated exact origins, with no trailing slash. Example:
APP_ORIGINS=http://localhost:5173

# Integration event worker settings
INTEGRATION_WORKER_INTERVAL_MS=300000
INTEGRATION_WORKER_BATCH_SIZE=100
INTEGRATION_MAX_ATTEMPTS=5
INTEGRATION_LEASE_MS=300000
INTEGRATION_RETRY_DELAYS_MS=60000,300000,900000,3600000
INTEGRATION_RETENTION_INTERVAL_MS=86400000
INTEGRATION_RETENTION_BATCH_SIZE=500
INTEGRATION_EVENT_RETENTION_DAYS=90
INTEGRATION_ATTEMPT_RETENTION_DAYS=180
INTEGRATION_DIAGNOSTIC_RETENTION_DAYS=90
ANALYTICS_OUTBOX_RETENTION_DAYS=90
